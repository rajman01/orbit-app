# Copy to .env.local and fill in.
MONGODB_URI=mongodb://127.0.0.1:27017/orbit   # MongoDB Atlas connection string in production
BETTER_AUTH_SECRET=                            # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000          # public URL of the app
GOOGLE_CLIENT_ID=                              # optional: enables "Continue with Google"
GOOGLE_CLIENT_SECRET=

# Local test account for e2e checks (development database only)
E2E_EMAIL=dev@orbit.test
E2E_PASSWORD=
