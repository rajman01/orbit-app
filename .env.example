# Copy to .env.local and fill in.
MONGODB_URI=mongodb://127.0.0.1:27017/orbit   # MongoDB Atlas connection string in production
BETTER_AUTH_SECRET=                            # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000          # public URL of the app
GOOGLE_CLIENT_ID=                              # optional: enables "Continue with Google"
GOOGLE_CLIENT_SECRET=

# Local test account for e2e checks (development database only)
E2E_EMAIL=dev@orbit.test
E2E_PASSWORD=

# Web Push (Phase 1D): generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://your-orbit-domain.example
# Shared secret the per-minute scheduler sends as "Authorization: Bearer <secret>"
CRON_SECRET=
# Calendars (Phase 2B): 32 random bytes, base64. Generate with: openssl rand -base64 32
CALENDAR_ENCRYPTION_KEY=
# AI coach (Phase 2A). Without a key the coach shows a "not set up" message.
ANTHROPIC_API_KEY=
# Optional: daily spend cap per user in USD (default 2), and model overrides.
AI_DAILY_LIMIT_USD=
AI_CHAT_MODEL=
AI_LIGHT_MODEL=
